{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "identifier": "default",
  "description": "Default capabilities for the app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "global-shortcut:default",
    "store:default",
    "fs:default",
    "dialog:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://freesound.org/*" },
        { "url": "https://api.freesound.org/*" }
      ]
    }
  ]
}
